# =============================================================================
# OMA-AI Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Runtime environment (development, production, test, staging, preview)
NODE_ENV=development

# Port for the API server
PORT=3001

# Canonical production domain (used for SIWE domain binding)
PRIMARY_DOMAIN=oma-ai.com

# Public-facing API URL (used by OpenAPI spec, SSO, etc.)
PUBLIC_API_URL=http://localhost:3001

# CORS origin for API responses
CORS_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Database & Cache
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (Neon, Supabase, etc.)
# DATABASE_URL=postgresql://user:pass@localhost:5432/oma

# Redis connection URL (for rate limiting, caching, sessions)
REDIS_URL=redis://localhost:6379

# Neon Postgres connection pool size (used with PgBouncer)
CONNECTION_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Better Auth session secret — THE auth secret (min 32 chars). MUST match
# app/.env BETTER_AUTH_SECRET so both runtimes validate the same cookie.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-in-prod-32ch

# Base URL Better Auth uses for callbacks. Dev = Next app port (:3000).
# Production = the Next.js app origin (PUBLIC_APP_URL). Falls back to the
# API URL when unset.
# BETTER_AUTH_URL=http://localhost:3000

# Resend API key for magic-link emails. Unset = dev mode (links logged).
# RESEND_API_KEY=re_...
# RESEND_FROM=OMA <auth@oma-ai.com>

# Encryption key for sensitive data at rest (min 32 chars)
ENCRYPTION_KEY=dev-encryption-key-change-me-in-prod-32ch

# Better Auth owns CSRF protection; no separate CSRF secret is required.

# Trusted proxy IPs for X-Forwarded-For validation (comma-separated)
TRUSTED_PROXY_IPS=

# Receipt HMAC secret for payment receipts
RECEIPT_HMAC_SECRET=dev-receipt-hmac-placeholder

# -----------------------------------------------------------------------------
# Webhook Secrets (HMAC verification)
# -----------------------------------------------------------------------------
# Onramp (fiat) webhook HMAC secret
# ONRAMP_WEBHOOK_SECRET=whsec_...

# Shared secret for POST /internal/jobs/:name (GitHub Actions cron in
# .github/workflows/jobs.yml). >=32 chars. Unset = job triggers disabled (503).
# JOBS_TOKEN=openssl-rand-hex-32

# LI.FI deposit webhook HMAC secret
# LIFI_WEBHOOK_SECRET=whsec_...

# CCTP deposit webhook HMAC secret
# CCTP_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Blockchain / On-Chain
# -----------------------------------------------------------------------------
# Treasury address on Base mainnet (REQUIRED in production — real 0x…40-hex)
# TREASURY_BASE_ADDRESS=0x...

# Primary Base mainnet RPC URL (required in production)
# CHAIN_RPC_URL=https://your-quicknode-or-rpc-endpoint

# Fallback RPC URL
CHAIN_RPC_URL_FALLBACK=

# QuickNode RPC aliases (folded into CHAIN_RPC_URL*) — keep commented
# until set (empty URL values fail the startup schema validation).
# QUICKNODE_RPC_URL=
# QUICKNODE_RPC_URL_FALLBACK=

# Dedicated Ethereum mainnet RPC for ENS lookups during SIWE. Defaults to
# cloudflare-eth.com when unset.
# ETH_RPC_URL=https://eth.llamarpc.com

# Per-chain RPC URL map (comma-separated chain:url pairs)
# Example: "ethereum:https://eth.example.com,base:https://base.example.com"
CHAIN_RPC_URL_PER_CHAIN=

# Base mainnet chain ID
BASE_CHAIN_ID=8453

# x402 Facilitator configuration
FACILITATOR_MODE=mock
# Hot wallet signing EIP-3009 settlements — REQUIRED for coinbase-cdp live mode
# FACILITATOR_PRIVATE_KEY=0x...

# x402 facilitator provider: "coinbase-cdp" (default) or "quicknode"
X402_FACILITATOR_PROVIDER=coinbase-cdp
# QUICKNODE_X402_URL=https://your-endpoint.x402.quiknode.pro/your-token/
# QUICKNODE_X402_API_KEY=your_quicknode_x402_api_key

# CCTP (Circle Cross-Chain Transfer Protocol)
CCTP_CIRCLE_API_URL=https://iris-api.circle.com
CCTP_SOURCE_CHAINS=ethereum,arbitrum,optimism,polygon,avalanche
CCTP_BASE_DOMAIN=6

# LI.FI swap integration
LIFI_API_URL=https://li.quest/v1
LIFI_INTEGRATOR=oma-ai
LIFI_SOURCE_CHAINS=ethereum,arbitrum,optimism,polygon,avalanche,base,bsc,gnosis,fantom

# Surplus provider (x402 settlements on Base)
# SURPLUS_WALLET_PRIVATE_KEY=0x...
# All Surplus contract vars are 0x-prefixed 20-byte addresses; comment them
# out unless you run the Surplus fallback path.
# SURPLUS_VERIFIER_CONTRACT=0x...
# SURPLUS_SETTLEMENT_CONTRACT=0x...
# SURPLUS_PERMIT2_CONTRACT=0x...
# SURPLUS_USDC_CONTRACT=0x...
SURPLUS_CHAIN_ID=8453
SURPLUS_DEFAULT_SCHEME=upto
SURPLUS_MIN_DISCOUNT_PCT=0

# CheapTokens provider
# CHEAPTOKENS_ADDRESS=0x...
CT_DAILY_USDC_CENTS_MAX=0
# Kill switch for the CheapTokens provider (read directly, bypasses config)
# CHEAPTOKENS_FORCE_DISABLE=false

# Gonka decentralized provable inference broker
# GONKA_API_KEY=obk-your-key-here
GONKA_API_URL=https://api.openbroker.gonka.gg
# OPENBROKER_API_KEY=obk-your-key-here
OPENBROKER_API_URL=https://api.openbroker.gonka.gg

# Venice API (primary inference provider — OpenAI-compatible, pay-per-request in USDC)
# Get your admin key at https://docs.venice.ai
# The key is loaded from VENICE_API_KEY env var and must be set for Venice
# routing to work (87 Venice-hosted models return 503 until key is configured).
# Example: VENICE_API_KEY=VENICE_ADMIN_KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VENICE_API_KEY=sk-...
VENICE_API_URL=https://api.venice.ai

# Allow non-private Venice mode (dev only)
OMMA_ALLOW_NON_PRIVATE_VENICE=false

# TinyFish API
TINYFISH_API_KEY=

# -----------------------------------------------------------------------------
# Inference & Provider Settings
# -----------------------------------------------------------------------------
# Provider request timeouts (ms)
PROVIDER_TIMEOUT_STREAM_MS=120000
PROVIDER_TIMEOUT_NON_STREAM_MS=60000

# Weighted load balancing for provider failover (format: "venice:95,gonka:5")
PROVIDER_WEIGHTS=

# Per-model weighted load balancing (format: "modelId=provider:weight,...")
MODEL_WEIGHTS=

# Path to models.json config file
MODELS_CONFIG_PATH=

# -----------------------------------------------------------------------------
# Onramp (Fiat-to-Credits) Configuration
# -----------------------------------------------------------------------------
# USD to credits conversion rate (credits per USD)
CREDITS_PER_USD=100

# Min/max USD per quote
ONRAMP_MIN_USD=10
ONRAMP_MAX_USD=1000

# Processing fee percentage
ONRAMP_PROCESSING_FEE_PERCENT=2.9

# Quote cache TTL (ms)
ONRAMP_QUOTE_CACHE_TTL_MS=600000

# -----------------------------------------------------------------------------
# Credit Ledger & Spending Limits
# -----------------------------------------------------------------------------
# Credit expiry in days
CREDIT_EXPIRY_DAYS=90

# Daily spend limit (cents)
SPEND_LIMIT_DAILY_CENTS=10000

# Auto-reload thresholds
AUTO_RELOAD_THRESHOLD=50000
AUTO_RELOAD_AMOUNT=1000000
AUTO_RELOAD_SPEND_LIMIT=1000000

# Minimum deposit floor (USD)
MIN_DEPOSIT_USD=10

# -----------------------------------------------------------------------------
# Free Trial & USDC Deposits
# -----------------------------------------------------------------------------
# Free trial credits minted on first sign-in (1 credit = 1 cent). 100 = $1.00.
# Set to 0 to disable. Without this, new users hit "insufficient balance" on
# their very first call.
FREE_SIGNUP_CENTS=100

# Base wallet that receives USDC deposits and credits balances after on-chain
# confirmation. Empty in dev = /v1/deposit/usdc surfaces a 503. MUST match
# app/.env NEXT_PUBLIC_TREASURY_BASE_ADDRESS.
# USDC_DEPOSIT_ADDRESS=0x...
# USDC_DEPOSIT_MIN_CENTS=100
# USDC_DEPOSIT_MAX_CENTS=1000000

# -----------------------------------------------------------------------------
# Markup & Pricing
# -----------------------------------------------------------------------------
# Global markup percentage
OMA_MARKUP_PCT=25

# Tiered markup strategy (format: "budget=40,mid=30,premium=22,frontier=15")
OMA_TIERED_MARKUP=

# Model-specific markup overrides (format: "model-a=25,model-b=10")
OMA_MODEL_MARKUP_OVERRIDES=

# Price override for testing (keep commented when unset)
# OMA_PRICE_OVERRIDE=

# -----------------------------------------------------------------------------
# Session & Auth
# -----------------------------------------------------------------------------
# Session cookie TTL (ms, default 1h)
SESSION_COOKIE_TTL_MS=3600000

# Default API key expiry (days, 0 = never)
DEFAULT_KEY_EXPIRY_DAYS=90

# Admin wallet addresses (comma-separated)
ADMIN_WALLET_ADDRESSES=

# Platform team ID
PLATFORM_TEAM_ID=

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=oma-server

# -----------------------------------------------------------------------------
# Debug & Development
# -----------------------------------------------------------------------------
DEBUG_STREAM=false

# -----------------------------------------------------------------------------
# Build Metadata (injected at build time)
# -----------------------------------------------------------------------------
# BUILD_SHA=git-commit-sha
# BUILD_TIME=2024-01-01T00:00:00.000Z

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# OMA test/live mode flags (dev/CI only)
OMA_RUN_INTEGRATION=false
OMA_RUN_LIVE=false
OMA_TEST_ACCOUNT=false
OMA_ADMIN_DEBUG_KEY=
OMA_KEY=
OMA_LIVE_API_KEY=
OMA_LIVE_PROVIDER=

# Server logger level (trace, debug, info, warn, error, fatal)
# LOG_LEVEL=info

# Affinity cache TTL (ms, default 5 min)
# AFFINITY_TTL_MS=300000

# Additional SIWE allowed domains (comma-separated)
# ALLOWED_SIWE_DOMAINS=dev.oma-ai.com,staging.oma-ai.com
# -----------------------------------------------------------------------------
# Polar.sh — subscription billing (Merchant of Record)
# -----------------------------------------------------------------------------
# Get tokens from https://dashboard.polar.sh → Settings → Developers → API Tokens.
# Set POLAR_SERVER to "sandbox" if you have a sandbox OAT instead of production.
# WARNING: production OATs and sandbox OATs are SEPARATE secrets. Using a
# production OAT with POLAR_SERVER=sandbox (or vice versa) returns 401 with
# no other diagnostic. Verify by curling each server with the token.
#
# POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POLAR_WEBHOOK_SECRET=polar_whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POLAR_ORGANIZATION_ID=org_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POLAR_SERVER=production   # "production" (default) | "sandbox" — NOT a URL
#
# Per-plan product UUIDs (one per Polar product in your dashboard):
# POLAR_HOBBY_PRODUCT_ID=
# POLAR_BUILDER_PRODUCT_ID=
# POLAR_SCALE_PRODUCT_ID=
#
# Public app URL — used to build checkout success/cancel URLs.
# PUBLIC_APP_URL=https://oma-ai.com
