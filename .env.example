# OMA-AI environment
#
# Copy to .env.local (Next.js app) and/or server/.env (API server) and fill in.
# Every variable below is referenced by code on the current branch; the list was
# generated from process.env.* references under app/src and server/src rather
# than maintained by hand, so it does not drift from what the app actually reads.
#
# Deployment is Vercel. The Coolify/Docker deployment paths were removed, so
# there are no PORT, CORS_ORIGIN, PRIMARY_DOMAIN or DATABASE_URL entries here
# any more. See docs/DEPLOYMENT.md for the canonical topology.

# ---------------------------------------------------------------- public URLs

# Canonical site URL. Apex oma-ai.com 308-redirects to www; always use www.
# api.oma-ai.com does not exist (NXDOMAIN) and must not be created.
NEXT_PUBLIC_APP_URL=https://www.oma-ai.com
PUBLIC_APP_URL=https://www.oma-ai.com
NEXT_PUBLIC_API_URL=https://www.oma-ai.com
NEXT_PUBLIC_AUTH_BASE_URL=https://www.oma-ai.com

# --------------------------------------------------------------------- server

# Server log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Absolute path to the models config JSON read by server/src/config.ts
MODELS_CONFIG_PATH=./config/models.json

# Absolute path to the model-overrides JSON read by server/lib/model-overrides.ts
MODEL_OVERRIDES_PATH=./config/model-overrides.json

# Shared secret for the website-to-server proxy. The proxy rejects requests
# that do not carry a matching header, so it must be set in production.
# Generate with: openssl rand -hex 32
INTERNAL_PROXY_SECRET=

# Recovery/admin token used by server/src/index.ts
RECOVERY_TOKEN=

# Test-only Postgres URL for the credit and payment integration suites.
# Never point this at production.
CREDIT_TEST_DATABASE_URL=

# Allows dev-mode endpoints to be served outside production. Keep unset in prod.
ALLOW_DEV_MODE_DEPLOY=

# ---------------------------------------------------------------------- client

# Google Analytics measurement id. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# WalletConnect / etherscan project id for wallet linking.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated admin wallet addresses.
NEXT_PUBLIC_ADMIN_WALLETS=

# Discord/Slack webhook the /api/support route posts to.
SUPPORT_WEBHOOK_URL=

# Vercel-injected. Do not set by hand.
VERCEL=
NEON_FUNCTION=
NODE_ENV=

# Public API key shown in website code examples and agent docs. This is the
# customer-facing demo key, not a privileged secret.
OMA_API_KEY=