# OMA website environment — copy to app/.env.local for local development.
# Production uses Vercel configuration; secrets must never use NEXT_PUBLIC_*.

# Backend origin used by same-origin API/auth handlers.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional separate auth backend; defaults to NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3001

# Same secret as the API's INTERNAL_PROXY_SECRET. Required on deployed proxies.
# INTERNAL_PROXY_SECRET=

# Optional analytics. Unset disables tracking.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional mobile/QR wallets. Public Reown project ID (32 hex characters).
# Register https://www.oma-ai.com in your Reown project's allowed origins.
# Missing/invalid IDs keep this connector hidden; injected wallets still work.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional private RPC origins; browser requests go through /api/rpc/*.
# Without these, the proxies use their configured public fallback endpoints.
# BASE_RPC_URL=https://your-base-mainnet-endpoint/
# BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-endpoint/

# Optional support delivery webhook. Missing/failed delivery is shown to users.
# SUPPORT_WEBHOOK_URL=https://hooks.example.com/oma-support

# Optional build label; VERCEL_GIT_COMMIT_SHA takes precedence.
# NEXT_PUBLIC_BUILD_SHA=abc1234

# Better Auth runs in the API; the website forwards its cookies and requests.
# Provider keys, database credentials, auth/payment secrets and treasury
# configuration belong in server/.env, not the website environment.
# See docs/PLATFORM.md and docs/DEPLOYMENT.md.
