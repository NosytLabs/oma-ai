# OMA App Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Vercel, Coolify, etc.)

# =============================================================================
# API Configuration
# =============================================================================

# Backend API server URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend treasury address (server-side only). Read by the A2A agent-card
# route to stamp the x402 payee. MUST match server/.env TREASURY_BASE_ADDRESS.
# TREASURY_BASE_ADDRESS=0x...

# Frontend app URL (for redirects, metadata, OG images, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Analytics
# =============================================================================

# Google Analytics 4 measurement ID (GA4 data-stream Measurement ID, e.g.
# G-XXXXXXXXXX). Renders the gtag.js tag in <head> AFTER interactive hydration
# ONLY when set, so local dev / preview builds never send production traffic.
# Leave blank to disable GA entirely. The CSP in next.config.ts auto-allows
# googletagmanager.com when this is set. Current production value lives in the
# Vercel env (OMA-AI.com GA4 property, web stream "oma").
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Better Auth API base (SSR only). The browser client uses the same-origin
# /api/auth/* proxy by default; this override is for unusual deploys.
# Falls back to NEXT_PUBLIC_API_URL, then localhost:3001.
#
# For local dev: uncomment the line below so /api/auth/* proxy forwards
# to the oma-server process (which runs on :3001 per server/.env PORT).
# Without this, the proxy falls back to NEXT_PUBLIC_API_URL (also :3001)
# but if you ever run server on a different port, set this explicitly.
# NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3001

# =============================================================================
# Backend Auth (server-side only — never exposed to the browser)
# =============================================================================

# Better Auth session secret. MUST MATCH server/.env BETTER_AUTH_SECRET so
# both sides can verify sessions. Generate with: openssl rand -hex 32.
# COMMENTED: local dev falls back to a built-in dev default (server config.ts).
# In any deployed environment you MUST set a real 64-hex value — the server
# hard-fails at startup in production if this is the dev placeholder.
# BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32

# Base URL the Next-side Better Auth instance uses to reach the backend's
# session API. Falls back to NEXT_PUBLIC_API_URL, then localhost:3001.
# BETTER_AUTH_URL=https://oma-ai.com

# Better Auth owns session signing and CSRF protection; no legacy JWT or
# separate CSRF secret is required in the app environment.

# =============================================================================
# RPC Endpoints (Optional — falls back to public RPC if not set)
# =============================================================================

# Base Mainnet RPC (server-side only — proxied via /api/rpc/base). Used by the
# app's JSON-RPC route handler; the client never sees this URL.
# Get from: https://www.quicknode.com/endpoints
# BASE_RPC_URL=https://your-endpoint.base-mainnet.quiknode.pro/your-api-token/

# Base Sepolia Testnet RPC (server-side only — proxied via /api/rpc/base-sepolia).
# Only needed if you have a dedicated Sepolia endpoint. When unset, the proxy
# falls back to the public Sepolia RPC.
# BASE_SEPOLIA_RPC_URL=https://your-endpoint.base-sepolia.quiknode.pro/your-api-token/

# NOTE: The server (server/.env) accepts its own RPC vars: CHAIN_RPC_URL and
# the QUICKNODE_RPC_URL alias. The app example above is for the Next.js
# /api/rpc/* proxy, which reads BASE_RPC_URL / BASE_SEPOLIA_RPC_URL.

# =============================================================================
# Build Metadata (Optional — injected at build time)
# =============================================================================

# Shown in the navbar + footer build chip. Falls back to "dev".
# NEXT_PUBLIC_BUILD_SHA=abc1234
# NEXT_PUBLIC_BUILD_DATE=2026-01-01T00:00:00Z
# VERCEL_GIT_COMMIT_SHA is picked up automatically on Vercel builds.

# =============================================================================
# Support / Contact (Optional)
# =============================================================================

# Webhook URL the /api/support route posts contact form messages to.
# Unset = the form surfaces an error instead of silently dropping.
# SUPPORT_WEBHOOK_URL=https://hooks.example.com/oma-support

# =============================================================================
# Marketing Demo (Optional — demo curl examples on /models + home)
# =============================================================================

# Server-side-only key used by marketing demo components to render live
# pricing examples (never sent to the browser as a secret). Safe to leave
# unset in local dev.
# OMA_API_KEY=oma_sk_your_demo_key_here
# OMA_KEY=oma_sk_your_demo_key_here

# =============================================================================
# Development Overrides
# =============================================================================

# Use localhost for backend during development
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Shared secret between the Vercel proxy handlers and the Neon API (required).
# INTERNAL_PROXY_SECRET=
