# OMA App Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Vercel, Coolify, etc.)

# =============================================================================
# API Configuration
# =============================================================================

# Backend API server URL
NEXT_PUBLIC_API_URL=https://api.oma-ai.com

# Frontend app URL (for redirects, metadata, OG images)
NEXT_PUBLIC_APP_URL=https://oma-ai.com

# =============================================================================
# WalletConnect (Required for Web3 wallet connections)
# =============================================================================

# Get free project ID at: https://cloud.walletconnect.com
# 1. Create account → 2. Create project → 3. Copy Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# Treasury Addresses (Your wallet addresses for deposits)
# =============================================================================

# Base network treasury address (EVM - 0x... format).
# MUST match server/.env TREASURY_BASE_ADDRESS so the server watches the
# same address users send to. App code reads this via:
#   app/src/app/deposit/_constants.ts:32 → treasuryAddress
NEXT_PUBLIC_TREASURY_BASE_ADDRESS=0xYourBaseWalletAddressHere

# =============================================================================
# RPC Endpoints (Optional - falls back to public RPC if not set)
# =============================================================================

# QuickNode Base Mainnet RPC (recommended for production)
# Get from: https://www.quicknode.com/endpoints
NEXT_PUBLIC_QUICKNODE_MAINNET_URL=https://your-endpoint.base.quiknode.pro/your-api-token/

# QuickNode Base Sepolia Testnet RPC
NEXT_PUBLIC_QUICKNODE_TESTNET_URL=https://your-endpoint.base-sepolia.quiknode.pro/your-api-token/

# =============================================================================
# Development Overrides
# =============================================================================

# Use localhost for backend during development
# NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# Optional Features
# =============================================================================

# Feature flags (uncomment to enable)
# NEXT_PUBLIC_FEATURE_SOLANA=true
# NEXT_PUBLIC_FEATURE_SWAP=true

# Neon Auth (managed by Neon MCP: mcp__neon__provision_neon_auth).
# Base URL of the Neon Auth host. The frontend uses this to call the
# Better Auth compatible REST API for email/password sign-in, OAuth, and
# SIWE/account-number plugin routes. When unset, Neon Auth is not used
# and the existing SIWE / Solana / account-number flows are unaffected.
# Get the value from mcp__neon__get_neon_auth_config → base_url.
# NEXT_PUBLIC_NEON_AUTH_URL=

# =============================================================================
# Backend Auth (server-side only)
# =============================================================================

# JWT secret — MUST match server/.env JWT_SECRET. The app uses this in
# middleware.ts to verify server-issued session JWTs. Server-side only;
# never expose to the browser (no NEXT_PUBLIC_ prefix).
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-in-prod-32ch

# OMA_API_KEY — server-to-server auth key used by app code paths that call
# the backend directly (e.g. /use-cases/* demo pages). Must match server/.env.
# OMA_API_KEY=oma_sk_...

# OMA_AGENT_KEY — separate key for autonomous agent / cron callbacks.
# Must match server/.env OMA_AGENT_KEY. Used in /docs and X402Section.
# OMA_AGENT_KEY=oma_ag_...

# =============================================================================
# Chat Completions Proxy (server-side only)
# =============================================================================

# Set to 'true' to enable the /api/v1/chat/completions Next.js route as a
# thin proxy to the Hono backend. Required for Model B (same-origin), optional
# for Model A. When unset or 'false', the route short-circuits to HTTP 503.
# CHAT_PROXY_ENABLED=false

# Optional: override the upstream API URL used by the proxy (defaults to
# NEXT_PUBLIC_API_URL). Use this when the proxy should reach an internal URL
# while the public client uses a different one.
# API_URL=http://localhost:3001