# OMA App Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Vercel, Coolify, etc.)

# =============================================================================
# API Configuration
# =============================================================================

# Backend API server URL
NEXT_PUBLIC_API_URL=https://api.oma-ai.com

# Frontend app URL (for redirects, metadata, OG images)
NEXT_PUBLIC_APP_URL=https://oma-ai.com

# =============================================================================
# WalletConnect (Required for Web3 wallet connections)
# =============================================================================

# Get free project ID at: https://cloud.walletconnect.com
# 1. Create account → 2. Create project → 3. Copy Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# =============================================================================
# Treasury Addresses (Your wallet addresses for deposits)
# =============================================================================

# Base network treasury address (EVM - 0x... format).
# MUST match server/.env TREASURY_BASE_ADDRESS so the server watches the
# same address users send to. App code reads this via:
#   app/src/app/deposit/_constants.ts:32 → treasuryAddress
NEXT_PUBLIC_TREASURY_BASE_ADDRESS=0xYourBaseWalletAddressHere

# =============================================================================
# RPC Endpoints (Optional - falls back to public RPC if not set)
# =============================================================================

# QuickNode Base Mainnet RPC (server-side only — proxied via /api/rpc/base)
# The client never sees this URL; JSON-RPC calls go through the Next.js
# route handler which forwards to QuickNode. No NEXT_PUBLIC_ prefix.
# Get from: https://www.quicknode.com/endpoints
# QUICKNODE_RPC_URL=https://your-endpoint.base-mainnet.quiknode.pro/your-api-token/

# QuickNode Base Sepolia Testnet RPC (server-side only — proxied via /api/rpc/base-sepolia)
# Only needed if you have a dedicated Sepolia endpoint. When unset, the
# proxy falls back to the public Sepolia RPC.
# QUICKNODE_RPC_URL_FALLBACK=https://your-endpoint.base-sepolia.quiknode.pro/your-api-token/

# =============================================================================
# Development Overrides
# =============================================================================

# Use localhost for backend during development
# NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# Backend Auth (server-side only)
# =============================================================================

# JWT secret — MUST match server/.env JWT_SECRET. The app uses this in
# middleware.ts to verify server-issued session JWTs. Server-side only;
# never expose to the browser (no NEXT_PUBLIC_ prefix).
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-in-prod-32ch

# OMA_API_KEY — server-to-server auth key used by app code paths that call
# the backend directly (e.g. /use-cases/* demo pages). Must match server/.env.
# OMA_API_KEY=oma_sk_...

# OMA_AGENT_KEY — separate key for autonomous agent / cron callbacks.
# Must match server/.env OMA_AGENT_KEY. Documentation-only example, not consumed at runtime.
# OMA_AGENT_KEY=oma_ag_...

# =============================================================================
# Error Monitoring (Sentry)
# =============================================================================

# Sentry DSN for error tracking. Leave unset to disable Sentry and fall back
# to the custom /v1/log backend forwarding.
# Get your DSN at: https://sentry.io/settings/projects/oma-app/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry auth token for source-map upload during builds.
# Only needed if you want release artifacts + unminified stack traces.
# Create at: https://sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=sntrys_xxx

# Sentry org and project names (used by the webpack plugin).
# SENTRY_ORG=oma-ai
# SENTRY_PROJECT=oma-app

# NOTE: CHAT_PROXY_ENABLED and the /api/v1/chat/completions Next.js proxy
# were removed. The frontend now calls NEXT_PUBLIC_API_URL/v1/chat/completions
# directly (same as the rest of the API surface).
# NOTE: API_URL override removed — the admin-config shim re-exports
# DEFAULT_API_URL (from NEXT_PUBLIC_API_URL) for the remaining proxy routes.