{
  "name": "app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-changelog.mjs",
    "predev": "node scripts/generate-changelog.mjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "dev": "next dev",
    "lint": "eslint",
    "start": "cp -R public .next/standalone/ && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/ && node .next/standalone/server.js",
