    "cuelume": "^0.2.1",
    "date-fns": "^4.4.0",
    "ethers": "^6.17.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.1.0",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
