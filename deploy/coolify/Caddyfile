# OMA-AI Caddy Reverse Proxy Configuration
# ==========================================
# Place this file on your server and load with:
#   caddy reload --config Caddyfile
#
# This configuration handles:
#   - Frontend at your-domain.com (port 3000)
#   - API at api.your-domain.com (port 3001)
#   - Automatic HTTPS via Let's Encrypt
#
# IMPORTANT: Replace every instance of "your-domain.com" (and admin@your-domain.com)
# with your actual domain and email address.

# =============================================================================
# Global Configuration
# =============================================================================
{
    # Email for certificate notifications
    email admin@your-domain.com
    # Store certificates in this directory
    storage file_system /data/caddy
}

# =============================================================================
# HTTP to HTTPS Redirect (all sites)
# =============================================================================
http:// {
    # Redirect all HTTP traffic to HTTPS
    redir https://{host}{uri}
}

# =============================================================================
# Frontend Application (Next.js)
# =============================================================================
your-domain.com, www.your-domain.com {
    # Reverse proxy to Next.js frontend
    reverse_proxy localhost:3000

    # Enable compression
    encode gzip zstd

    # Security headers
    header {
        # Remove server identification
        -Server
        # XSS protection
        X-XSS-Protection "1; mode=block"
        # Content type sniffing protection
        X-Content-Type-Options nosniff
        # Clickjacking protection
        X-Frame-Options DENY
        # Referrer policy
        Referrer-Policy strict-origin-when-cross-origin
        # Content Security Policy (customize as needed)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.your-domain.com https://*.walletconnect.com wss://*.walletconnect.com;"
    }

    # Logging
    log {
        output file /var/log/caddy/frontend.log
        level INFO
    }

    # Handle errors with custom page
    handle_errors {
        rewrite * /error.html
        file_server
    }
}

# =============================================================================
# API Server (Hono)
# =============================================================================
api.your-domain.com {
    # Reverse proxy to API server
    reverse_proxy localhost:3001

    # Enable compression
    encode gzip

    # Security headers
    header {
        -Server
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # Allow API access from frontend
        Access-Control-Allow-Origin "https://your-domain.com"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Houdini-Order-Id, X-Houdini-Signature"
        Access-Control-Max-Age 86400
    }

    # CORS preflight for API
    @options method OPTIONS
    handle @options {
        header {
            Access-Control-Allow-Origin "https://your-domain.com"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Houdini-Order-Id, X-Houdini-Signature"
            Access-Control-Max-Age 86400
        }
        respond ""
    }

    # Rate limiting (optional - enable if needed)
    # rate-limit {
    #     name api-rate-limit
    #     match @options {
    #         skip
    #     }
    # }

    # Logging
    log {
        output file /var/log/caddy/api.log
        level INFO
    }
}

# =============================================================================
# Health Check Endpoint (for monitoring)
# =============================================================================
health.your-domain.com {
    # Direct health check without full proxy
    respond "OK" 200
}