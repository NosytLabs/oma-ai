# OMA-AI Caddy Reverse Proxy Configuration
# ==========================================
# Place this file on your server and load with:
#   caddy reload --config Caddyfile
#
# This configuration handles:
#   - Frontend at your-domain.com (port 3000)
#   - API at api.your-domain.com (port 3001)
#   - Automatic HTTPS via Let's Encrypt
#
# IMPORTANT: Replace every instance of "your-domain.com" (and admin@your-domain.com)
# with your actual domain and email address.

# =============================================================================
# Global Configuration
# =============================================================================
{
    email admin@your-domain.com
    storage file_system /data/caddy
}

# =============================================================================
# Frontend Application (Next.js)
# =============================================================================
your-domain.com, www.your-domain.com {
    # Handle ACME challenges for both domain variants
    @acme path /.well-known/acme-challenge/*
    handle @acme {
        root * /var/www/certbot
        file_server
    }

    # Reverse proxy to Next.js frontend
    reverse_proxy app:3000

    # Enable compression
    encode gzip zstd

    # WebSocket support headers
    header {
        Upgrade $http_upgrade
        Connection "upgrade"
    }

    # Security headers
    header {
        -Server
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.your-domain.com https://*.walletconnect.com wss://*.walletconnect.com;"
    }

    log {
        output file /var/log/caddy/frontend.log
        level INFO
    }

    handle_errors {
        rewrite * /error.html
        file_server
    }
}

# =============================================================================
# API Server (Hono)
# =============================================================================
api.your-domain.com {
    # Handle ACME challenges
    @acme path /.well-known/acme-challenge/*
    handle @acme {
        root * /var/www/certbot
        file_server
    }

    # Health check endpoint
    @health path /health
    handle @health {
        respond "OK" 200
    }

    # Reverse proxy to API server
    reverse_proxy server:3001

    # Enable compression
    encode gzip

    # WebSocket support headers
    header {
        Upgrade $http_upgrade
        Connection "upgrade"
    }

    # Security headers
    header {
        -Server
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Access-Control-Allow-Origin "https://your-domain.com"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Houdini-Order-Id, X-Houdini-Signature"
        Access-Control-Max-Age 86400
    }

    @options method OPTIONS
    handle @options {
        header {
            Access-Control-Allow-Origin "https://your-domain.com"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Houdini-Order-Id, X-Houdini-Signature"
            Access-Control-Max-Age 86400
        }
        respond ""
    }

    log {
        output file /var/log/caddy/api.log
        level INFO
    }
}