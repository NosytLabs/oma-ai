# ============================================
# OMA-AI Complete Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# For Coolify: Import these as environment variables in the dashboard
# For external services: Use the provided connection strings
# For local services: The defaults below will work with docker-compose

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# Set to 'production' when deploying to production
NODE_ENV=production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Option 1: Local PostgreSQL (via docker-compose)
#   DATABASE_URL=postgresql://oma:changeme@db:5432/oma?sslmode=disable
#   DB_USER=oma
#   DB_PASSWORD=changeme
#   DB_NAME=oma
#   DB_PORT=5432

# Option 2: External PostgreSQL (Neon, Supabase, Railway, etc.)
#   DATABASE_URL=postgresql://user:password@host:5432/oma?sslmode=require
DATABASE_URL=postgresql://oma:changeme@db:5432/oma?sslmode=disable

# =============================================================================
# REDIS (Cache/Sessions)
# =============================================================================
# Option 1: Local Redis (via docker-compose)
#   REDIS_URL=redis://:changeme@redis:6379
#   REDIS_PASSWORD=changeme
#   REDIS_PORT=6379

# Option 2: External Redis (Upstash, Redis Cloud, etc.)
#   REDIS_URL=redis://default:password@host.upstash.io:6379
REDIS_URL=redis://:changeme@redis:6379
REDIS_PASSWORD=changeme

# =============================================================================
# PORTS
# =============================================================================
API_PORT=3001
FRONTEND_PORT=3000

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
# JWT secret for token signing - MUST be 40+ characters in production
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64

# AES-256-GCM encryption key for at-rest secrets (TOTP 2FA)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-encryption-key-base64

# CSRF protection secret (optional but recommended)
# CSRF_SECRET=change-me-csrf-secret

# HMAC secret for payment receipts (optional but recommended)
# RECEIPT_HMAC_SECRET=change-me-receipt-hmac-secret

# =============================================================================
# CORS (REQUIRED)
# =============================================================================
# Allowed origins for CORS (comma-separated, no spaces)
# For production, specify exact domains to prevent CORS attacks
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# =============================================================================
# AI PROVIDERS (REQUIRED)
# =============================================================================
# Venice AI API Key - Get yours at: https://venice.ai
VENICE_API_KEY=your-venice-api-key

# Venice API URL (default: https://api.venice.ai)
VENICE_API_URL=https://api.venice.ai

# Optional: additional active providers
# GONKA_API_KEY=your-gonka-key
# GONKA_API_URL=https://proxy.gonka.gg/v1
# TINYFISH_API_KEY=your-tinyfish-key

# =============================================================================
# FACILITATOR MODE
# =============================================================================
# mock = Use mock payments for testing (NOT ALLOWED IN PRODUCTION)
# live = Require real x402 facilitator for production payments
FACILITATOR_MODE=mock

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Base mainnet)
# =============================================================================
# Base Mainnet RPC URL
CHAIN_RPC_URL=https://base-rpc.publicnode.com

# Facilitator private key (for live mode, hex-encoded)
# FACILITATOR_PRIVATE_KEY=0x...

# =============================================================================
# PAYMENT & WALLETS
# =============================================================================
# Surplus wallet private key (for Surplus settlement path)
# SURPLUS_WALLET_PRIVATE_KEY=0x...

# Onramp webhook secret (for verifying payment callbacks)
# ONRAMP_WEBHOOK_SECRET=your-onramp-webhook-secret

# =============================================================================
# ADMIN ACCESS
# =============================================================================
# Comma-separated list of wallet addresses that get admin access
# ADMIN_WALLET_ADDRESSES=0x...,0x...

# =============================================================================
# CREDIT LIMITS
# =============================================================================
# Daily spend limit per user in cents (10000 = $100.00)
SPEND_LIMIT_DAILY_CENTS=10000

# =============================================================================
# CROSS-CHAIN TRANSFER (CCTP)
# =============================================================================
# Circle CCTP API URL
CCTP_CIRCLE_API_URL=https://iris-api.circle.com

# Supported source chains for CCTP (comma-separated)
CCTP_SOURCE_CHAINS=solana,ethereum,arbitrum,optimism,polygon,avalanche

# Base chain domain ID
CCTP_BASE_DOMAIN=6

# =============================================================================
# LI.FI (Multi-chain Swaps)
# =============================================================================
# LI.FI API URL
LIFI_API_URL=https://li.quest/v1

# Integrator ID for tracking
LIFI_INTEGRATOR=oma-ai

# Supported source chains for LI.FI (comma-separated)
LIFI_SOURCE_CHAINS=ethereum,arbitrum,optimism,polygon,avalanche,base,solana,bsc

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# API URL for frontend to call
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# WalletConnect Project ID (for wallet connections)
# Get yours at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Treasury address (Base USDC — used by deposit UI + server settlement)
TREASURY_BASE_ADDRESS=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_TREASURY_BASE_ADDRESS=0x0000000000000000000000000000000000000001