# OMA Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# Usage: cp .env.server.example .env
# =============================================================================

# =============================================================================
# Required Variables
# =============================================================================

# Database connection string
DATABASE_URL=postgresql://oma:your_password_here@postgres:5432/oma

# Redis connection string (format: redis://host:port or redis://:password@host:port)
REDIS_URL=redis://redis:6379

# =============================================================================
# Authentication
# =============================================================================

# JWT secret (min 40 characters, use: openssl rand -hex 32)
JWT_SECRET=your-40-char-secret-key-here-minimum

# =============================================================================
# API Keys (AI Providers)
# =============================================================================

# Venice AI - Primary provider
VENICE_API_KEY=sk-...

# OpenRouter - Failover provider
OPENROUTER_API_KEY=sk-...

# Together AI - Failover provider
TOGETHER_API_KEY=...

# DeepInfra - Failover provider
DEEPINFRA_API_KEY=

# =============================================================================
# Server Configuration
# =============================================================================

# Environment mode (development | production)
NODE_ENV=production

# Server port
PORT=3001

# CORS origin (comma-separated list of allowed origins)
CORS_ORIGIN=https://oma-ai.com,https://www.oma-ai.com

# =============================================================================
# Payment Configuration
# =============================================================================

# Facilitator mode: "mock" for development, "production" for live payments
FACILITATOR_MODE=production

# Treasury addresses (for non-custodial settlements)
BASE_TREASURY=0x...
SOLANA_TREASURY=...

# =============================================================================
# Optional: Logging
# =============================================================================

# LOG_LEVEL=debug

# =============================================================================
# Coolify Deployment
# =============================================================================

# These are auto-set by Coolify, but can be overridden:
# POSTGRES_PASSWORD=auto-generated