# OMA Server Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Required Variables
# =============================================================================

# Database connection string
DATABASE_URL=postgresql://oma:your_password_here@host:5432/oma

# Redis connection string
REDIS_URL=redis://:your_redis_password@host:6379

# =============================================================================
# API Keys (AI Providers)
# =============================================================================

# Venice AI - Primary provider
VENICE_API_KEY=sk-...

# OpenRouter - Failover provider
OPENROUTER_API_KEY=sk-...

# Together AI - Failover provider
TOGETHER_API_KEY=...

# DeepInfra - Failover provider
DEEPINFRA_API_KEY=

# LiteLLM - Optional proxy provider (use for self-hosted model routing)
# LITELLM_API_KEY=sk-litellm-...
# LITELLM_PROXY_URL=http://localhost:4000

# TinyFish - Web search MCP (for fetch / search-augmented chat)
# TINYFISH_API_KEY=sk-tinyfish-...

# =============================================================================
# Authentication
# =============================================================================

# JWT secret (min 40 characters)
JWT_SECRET=your-40-char-secret-key-here-minimum

# Encryption key for TOTP 2FA secrets (min 32 characters). Used for AES-256-GCM at-rest encryption.
# WARNING: Changing this will invalidate all stored 2FA secrets. Users will need to re-setup 2FA.
ENCRYPTION_KEY=your-32-char-encryption-key-here-minimum

# CSRF secret (min 32 characters). Required for session-based auth flows.
CSRF_SECRET=your-32-char-csrf-secret-here-minimum

# =============================================================================
# Server Configuration
# =============================================================================

# Environment mode
NODE_ENV=production

# Server port
PORT=3001

# CORS origin (comma-separated list of allowed origins)
# IMPORTANT: NEVER use "*" in production - startup will fail.
CORS_ORIGIN=https://oma-ai.com,https://www.oma-ai.com

# =============================================================================
# Payment Configuration
# =============================================================================

# Facilitator mode: "mock" for development, "production" for live
FACILITATOR_MODE=production

# Treasury addresses (for non-custodial settlements)
# BASE_TREASURY=0x...
# SOLANA_TREASURY=...

# EVM facilitator private key (for x402 settlement signing). REQUIRED in production.
# 32-byte hex, 0x-prefixed, no spaces. Used by server/src/inference/cheaptokens.ts.
# FACILITATOR_PRIVATE_KEY=0x...

# Surplus provider wallet private key (for x402 surplus / fallback path).
# Used by server/src/inference/surplus.ts. REQUIRED if FACILITATOR_MODE=production.
# SURPLUS_WALLET_PRIVATE_KEY=0x...

# HMAC secret for signing x402 payment receipts. REQUIRED in production.
# RECEIPT_HMAC_SECRET=your-32-char-hmac-secret-here-minimum

# =============================================================================
# Houdini / Cross-chain Bridge
# =============================================================================

# Houdini swap API key + secret + webhook secret
# HOUDINI_API_KEY=...
# HOUDINI_API_SECRET=...
# HOUDINI_WEBHOOK_SECRET=...

# =============================================================================
# Webhooks
# =============================================================================

# Onramp webhook signing secret (for verifying onramp provider callbacks)
# ONRAMP_WEBHOOK_SECRET=...

# =============================================================================
# Internal Service Auth
# =============================================================================

# OMA_API_KEY: server-to-server auth key for the Next.js app to call this API
# without going through user OAuth. Treat like a service-to-service password.
# OMA_API_KEY=oma_sk_...

# OMA_AGENT_KEY: separate key for autonomous agent / cron callbacks (deposit
# notifications, subscription jobs). Scoped to specific job handlers.
# OMA_AGENT_KEY=oma_ag_...

# =============================================================================
# Optional: Logging
# =============================================================================

# LOG_LEVEL=debug
