# OMA Server Environment Variables
# Copy this file to .env and fill in the values.

# =============================================================================
# Required Variables
# =============================================================================

# Database connection string
DATABASE_URL=postgresql://oma:your_password_here@host:5432/oma

# Redis connection string
REDIS_URL=redis://:your_redis_password@host:6379

# =============================================================================
# API Keys (AI Providers)
# =============================================================================

# Venice AI - Primary private inference provider
VENICE_API_KEY=sk-...
VENICE_API_URL=https://api.venice.ai

# Gonka decentralized provable-inference broker (optional).
# Default = OpenBroker (api.openbroker.gonka.gg) — 0% markup, GNK-settled, devshard-backed.
# Cheapest inference available (~$0.0000008 per 500-token request).
# Sign up at https://openbroker.gonka.gg/register to mint your obk-* API key.
# Other community brokers (proxy.gonka.gg, dahl.global, gonkabroker.com) also work —
# override via GONKA_API_URL. OPENBROKER_* are aliases; GONKA_* wins if both set.
# GONKA_API_KEY=obk-your-key-here
# GONKA_API_URL=https://api.openbroker.gonka.gg
# OPENBROKER_API_KEY=obk-your-key-here
# OPENBROKER_API_URL=https://api.openbroker.gonka.gg

# TinyFish web search / fetch (optional — used by /v1/search and /v1/fetch).
# TINYFISH_API_KEY=...

# Active providers: Venice, Surplus (dev-only when key set), Gonka, TinyFish (tools).
# Removed (no longer in Zod schema): OpenRouter, Together, DeepInfra, Morpheus,
# LiteLLM, AntSeed, Anthropic, Gemini, 0G.

# Allow Venice non-private mode. By default all Venice requests set
# venice_parameters.private=true. Set OMMA_ALLOW_NON_PRIVATE_VENICE=true to
# let callers opt out per-request (private:false) for non-sensitive traffic.
# Production should leave this unset (defaults to false).
# OMMA_ALLOW_NON_PRIVATE_VENICE=false

# =============================================================================
# Authentication
# =============================================================================

# JWT secret (min 40 characters)
JWT_SECRET=your-40-char-secret-key-here-minimum

# Encryption key for TOTP 2FA secrets (min 32 characters). Used for AES-256-GCM at-rest encryption.
# WARNING: Changing this will invalidate all stored 2FA secrets. Users will need to re-setup 2FA.
ENCRYPTION_KEY=your-32-char-encryption-key-here-minimum

# CSRF secret (min 32 characters). Required for session-based auth flows.
CSRF_SECRET=your-32-char-csrf-secret-here-minimum

# Session cookie TTL in milliseconds. Default 1h.
# SESSION_COOKIE_TTL_MS=3600000

# =============================================================================
# Server Configuration
# =============================================================================

# Environment mode
NODE_ENV=production

# Server port
PORT=3001

# CORS origin (comma-separated list of allowed origins)
# IMPORTANT: NEVER use "*" in production - startup will fail.
CORS_ORIGIN=https://oma-ai.com,https://www.oma-ai.com

# Public-facing API URL surfaced in the OpenAPI spec ("servers" list) and in
# SSO SAML entity/ACS URLs. Defaults to https://api.oma-ai.com.
PUBLIC_API_URL=https://api.oma-ai.com

# Enable debug stream logging. Defaults to false.
# DEBUG_STREAM=false

# =============================================================================
# Chain RPC Endpoints
# =============================================================================

# Primary Base mainnet RPC. Defaults to https://base-rpc.publicnode.com.
# When QUICKNODE_RPC_URL is set it takes precedence over CHAIN_RPC_URL.
# CHAIN_RPC_URL=https://base-rpc.publicnode.com
# Optional fallback Base RPC (used if CHAIN_RPC_URL is unresponsive).
# CHAIN_RPC_URL_FALLBACK=https://base.llamarpc.com

# QuickNode Base mainnet RPC (preferred in production). When set, used in place of
# CHAIN_RPC_URL for all on-chain x402 verification reads. Get endpoint URL from
# https://www.quicknode.com/endpoints (Base mainnet, HTTP+WS).
# Alias for CHAIN_RPC_URL — when set, folded into CHAIN_RPC_URL at startup.
QUICKNODE_RPC_URL=https://YOUR_QUICKNODE_ENDPOINT.quiknode.pro/YOUR_API_KEY/
# Optional fallback (alias for CHAIN_RPC_URL_FALLBACK).
QUICKNODE_RPC_URL_FALLBACK=https://base.llamarpc.com
# NOTE: x402 settlement delegation uses QUICKNODE_X402_URL + QUICKNODE_X402_API_KEY
# (separate from the RPC aliases above).

# Per-chain RPC URL map for CCTP, comma-separated `chain:url` pairs.
# Example: "ethereum:https://eth.example.com,base:https://base.example.com"
# When unset, cctp-client.ts falls back to viem's default RPC transport.
# CHAIN_RPC_URL_PER_CHAIN=

# CheapTokens contract address. Optional.
# CHEAPTOKENS_ADDRESS=0x...

# Base mainnet chain ID (used as default chainId in /v1/withdraw/usdc/quote).
# 8453 = Base mainnet. 84532 = Base Sepolia (testnet). Do NOT change unless you know what you're doing.
# BASE_CHAIN_ID=8453

# Trusted proxy IPs for X-Forwarded-For validation (comma-separated).
# Only trust X-Forwarded-For headers from these known proxy IPs.
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2

# Postgres connection pool size (used with PgBouncer)
# CONNECTION_POOL_SIZE=10

# =============================================================================
# Payment Configuration
# =============================================================================

# Facilitator mode: "mock" — development only (no on-chain settlement, signatures
# are NOT verified). "live" — production (real USDC settlement via EIP-3009).
# NOTE: Live x402 settlement requires a funded treasury on Base mainnet.
# Treasury address: 0x0770d2124C0a581C28Cfc47a659817145e6Cc137
# Required: USDC balance for settlements + native ETH for gas.
# Verify on BaseScan before flipping FACILITATOR_MODE=live:
#   https://basescan.org/address/0x0770d2124C0a581C28Cfc47a659817145e6Cc137
# NOTE: FACILITATOR_MODE=mock WILL NOT WORK in production or staging. The server
# will refuse to start with mock mode in those environments. Flip to "live"
# before deploying. Valid values are exactly: "mock" | "live".
FACILITATOR_MODE=mock

# =============================================================================
# x402 Settlement Path — choose ONE of the two options below:
#
# OPTION A — Coinbase CDP (default, recommended):
#   Verify and settle EIP-3009 transferWithAuthorization locally using viem.
#   Requires FACILITATOR_PRIVATE_KEY (hot wallet, 32-byte EVM private key).
#   All on-chain settlement goes through this key. Keep it secure.
#
# OPTION B — QuickNode x402 (delegated):
#   Delegate verify/settle to QuickNode's hosted x402 facilitator endpoint.
#   Requires: X402_FACILITATOR_PROVIDER=quicknode, QUICKNODE_X402_URL,
#   and QUICKNODE_X402_API_KEY. Your FACILITATOR_PRIVATE_KEY is not needed
#   in this mode, but TREASURY_BASE_ADDRESS still must be set.
# =============================================================================
X402_FACILITATOR_PROVIDER=coinbase-cdp
# QuickNode x402 endpoint URL — REQUIRED when X402_FACITATOR_PROVIDER=quicknode
QUICKNODE_X402_URL=https://your-endpoint.x402.quiknode.pro/your-token/
# QuickNode x402 API key — REQUIRED when X402_FACILITATOR_PROVIDER=quicknode
QUICKNODE_X402_API_KEY=your_quicknode_x402_api_key_here

# =============================================================================
# Treasury Address (REQUIRED in production — no exceptions)
# =============================================================================
# The EVM Base address where USDC deposits settle and x402 fees are collected.
# MUST be a real externally-owned account (EOA) or a multi-sig contract address.
# MUST NOT be a placeholder (0x111..., 0x222..., 0x333..., 0x000...).
# Generate a new wallet: npx ethers.Wallet.createRandom()
# If using Gnosis Safe multi-sig, use the Safe's Base address here.
# Server will refuse to start in production if this is a placeholder or unset.
# TREASURY_BASE_ADDRESS=0x...

# Flat USD price for one x402-paid /v1/chat/completions request (no account,
# settled per request via PAYMENT-SIGNATURE; max_tokens capped at 4096 on this
# path). "0" disables the 402 challenge; requires TREASURY_BASE_ADDRESS.
# X402_CHAT_PRICE_USD=0.10

# =============================================================================
# Facilitator Private Key (REQUIRED for Option A / coinbase-cdp path)
# =============================================================================
# 32-byte hex EVM private key, 0x-prefixed, 64 hex characters after the prefix.
# This is the hot wallet that signs EIP-3009 TransferWithAuthorization for
# every x402 payment. The corresponding address MUST match TREASURY_BASE_ADDRESS.
# Generate: npx ethers.Wallet.createRandom() — KEEP THIS SECRET.
# In staging/production, store this in your platform's secret manager
# (Render encrypted env var, Vercel env secret, Coolify secret, etc.).
# 32-byte hex EVM private key, 0x-prefixed. REQUIRED for Option A / coinbase-cdp.
# FACILITATOR_PRIVATE_KEY=0x...

# Surplus provider wallet private key (for x402 surplus / fallback path).
# Used by server/src/inference/surplus.ts. REQUIRED if FACILITATOR_MODE=live.
# SURPLUS_WALLET_PRIVATE_KEY=0x...

# HMAC secret for signing x402 payment receipts. REQUIRED in production.
RECEIPT_HMAC_SECRET=your-32-char-hmac-secret-here-minimum

# Markup percentage applied to inference billing. The markup multiplier is 1 + OMA_MARKUP_PCT/100.
# Example: 25 means a 25% markup on cost (1.25x multiplier). Range: 0-100.
# Used by server/src/inference/markup.ts.
# OMA_MARKUP_PCT=25

# Tiered markup strategy (best practice: higher margin on cheap models, lower on frontier).
# Format: "budget=40,mid=30,premium=22,frontier=15". Keyed off each model's category in models.json.
# Higher markup on budget/mid (price-sensitive buyers, tiny absolute $ delta), lower on frontier
# (inelastic buyers who churn on steep markup). Any tier missing falls back to OMA_MARKUP_PCT.
# OMA_TIERED_MARKUP=budget=40,mid=30,premium=22,frontier=15

# Model-specific markup overrides (format: "model-a=25,model-b=10")
# OMA_MODEL_MARKUP_OVERRIDES=

# Minimum deposit floor in USD. Prevents dust/spam deposits. Research (Flexprice, OpenRouter)
# shows $10 is the sweet spot. Applied to all deposit routes (usdc/cctp/lifi).
# MIN_DEPOSIT_USD=10

# Withdraw route fee configuration (used by server/src/routes/withdraw.ts).
# WITHDRAW_PROTOCOL_FEE_PERCENT is the percentage (NOT fraction). Default 0.1 = 0.1% (0.001 fraction).
# WITHDRAW_NETWORK_FEE_ESTIMATE_USD is the estimated on-chain network fee in USD.
# WITHDRAW_PROTOCOL_FEE_PERCENT=0.1
# WITHDRAW_NETWORK_FEE_ESTIMATE_USD=0.01
# WITHDRAW_DAILY_LIMIT_CENTS=5000000     # $50,000
# WITHDRAW_WEEKLY_LIMIT_CENTS=20000000   # $200,000
# WITHDRAW_NETWORK_FEE_CENTS=100         # $1.00

# =============================================================================
# LI.FI cross-chain aggregator
# =============================================================================

# LI.FI aggregator config. Defaults match the production endpoint.
# LIFI_API_URL=https://li.quest/v1
# LIFI_INTEGRATOR=oma-ai
# LIFI_SOURCE_CHAINS=ethereum,arbitrum,optimism,polygon,avalanche,base,solana,bsc,gnosis,fantom

# =============================================================================
# CCTP (Circle Cross-Chain Transfer Protocol)
# =============================================================================

# CCTP API endpoint. Default: https://iris-api.circle.com
# CCTP_CIRCLE_API_URL=https://iris-api.circle.com
# Comma-separated list of CCTP-supported source chains.
# CCTP_SOURCE_CHAINS=solana,ethereum,arbitrum,optimism,polygon,avalanche
# Base domain ID (CCTP uses integer domain IDs per chain).
# CCTP_BASE_DOMAIN=6

# =============================================================================
# Webhooks
# =============================================================================

# Onramp webhook signing secret (for verifying onramp provider callbacks)
# ONRAMP_WEBHOOK_SECRET=...

# =============================================================================
# Admin & Spend Limits
# =============================================================================

# Comma-separated EVM 0x wallet addresses granted admin access. Empty = no admins.
# ADMIN_WALLET_ADDRESSES=0xAdmin1,0xAdmin2
# Platform team ID (used for admin grouping)
# PLATFORM_TEAM_ID=

# Per-day spend limit for inference calls in cents. Default 10000 = $100.
# SPEND_LIMIT_DAILY_CENTS=10000

# Per-credit price override (in USD cents). If unset, server computes from oracle.
# OMA_PRICE_OVERRIDE=

# Hot-wallet auto-reload thresholds. The facilitator wallet is auto-topped-up
# from the operator treasury when balance falls below AUTO_RELOAD_THRESHOLD
# micro-USDC and is filled up to AUTO_RELOAD_AMOUNT micro-USDC, subject to
# AUTO_RELOAD_SPEND_LIMIT micro-USDC per day.
# AUTO_RELOAD_THRESHOLD=50000
# AUTO_RELOAD_AMOUNT=1000000
# AUTO_RELOAD_SPEND_LIMIT=1000000

# =============================================================================
# Credit / onramp / keys
# =============================================================================

# Credit batch expiry (days). Defaults to constants.ts CREDIT_EXPIRY_DAYS.
# CREDIT_EXPIRY_DAYS=365
# Per-onramp-quote USD bounds.
# ONRAMP_MIN_USD=10
# ONRAMP_MAX_USD=1000
# Onramp processing fee percent. Default 2.9.
# ONRAMP_PROCESSING_FEE_PERCENT=2.9
# Onramp quote cache TTL in ms. Default 600000 (10 min).
# ONRAMP_QUOTE_CACHE_TTL_MS=600000

# Affinity cache TTL in ms. Default 300000 (5 min).
# AFFINITY_TTL_MS=300000

# Default API key expiry in days (0 = never expires). Default 90.
# DEFAULT_KEY_EXPIRY_DAYS=90

# =============================================================================
# Provider Routing & Timeouts
# =============================================================================

# Weighted load balancing for provider failover
# Format: "venice:70,antseed:30,litellm:0,openrouter:0,together:0,deepinfra:0"
# Weights are relative proportions - higher weight = more traffic. 0 = disabled.
# If not set, defaults to sequential fallback (primary provider first, then others in order).
# PROVIDER_WEIGHTS=

# Per-model weighted load balancing (takes precedence over PROVIDER_WEIGHTS)
# Format: "gpt-4=venice:70,openrouter:30;dalle-3=openrouter:100;claude-3=venice:50,antseed:50"
# MODEL_WEIGHTS=

# Provider request timeouts (ms)
# PROVIDER_TIMEOUT_STREAM_MS=120000
# PROVIDER_TIMEOUT_NON_STREAM_MS=60000

# Path to models.json config file (supports absolute paths, useful for Docker/K8s deployments)
# MODELS_CONFIG_PATH=/app/models.json

# =============================================================================
# Surplus Provider
# =============================================================================

# All contract addresses are 0x-prefixed 20-byte EVM addresses.
# SURPLUS_MIN_DISCOUNT_PCT=0           # min acceptable discount (0-100); 0 = accept any
# SURPLUS_DEFAULT_SCHEME=upto          # "upto" or "exact"
# SURPLUS_CHAIN_ID=8453                # Base mainnet
# SURPLUS_SETTLEMENT_CONTRACT=0x0770d2124C0a581C28Cfc47a659817145e6Cc137
# SURPLUS_PERMIT2_CONTRACT=0x000000000022D473030F116dDEE9F6B43aC78BA3
# SURPLUS_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# SURPLUS_VERIFIER_CONTRACT=           # legacy EIP-712 verifyingContract; optional

# =============================================================================
# CheapTokens Reseller
# =============================================================================

# Per-day USDC spend cap in cents. 0 (or unset) = no cap.
# CT_DAILY_USDC_CENTS_MAX=0
# Set CHEAPTOKENS_FORCE_DISABLE=true to disable the CheapTokens provider at runtime
# (used as a kill switch). Code reads process.env directly so it bypasses config.ts.
# CHEAPTOKENS_FORCE_DISABLE=false

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================

# OTLP endpoint for traces/metrics. Default http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name reported in OTEL resource attributes. Default oma-server.
# OTEL_SERVICE_NAME=oma-server

# =============================================================================
# Cron / Build Metadata
# =============================================================================

# Build SHA injected at build time (used by /health endpoint). Usually set
# automatically by the Docker build. The /health route falls back to "dev".
# BUILD_SHA=
# Build timestamp (ISO 8601). The /health route falls back to the process start time.
# BUILD_TIME=

# =============================================================================
# Optional: Logging
# =============================================================================

# LOG_LEVEL=debug

# =============================================================================
# M5: Tunable Business Constants
# Defaults match the previous hardcoded values to preserve behavior.
# =============================================================================

# Onramp / fiat ramp (server/src/routes/onramp.ts)
# ONRAMP_MIN_USD=10
# ONRAMP_MAX_USD=1000
# ONRAMP_PROCESSING_FEE_PERCENT=2.9
# ONRAMP_QUOTE_CACHE_TTL_MS=600000  # 10 min

# Withdraw limits + fees (server/src/routes/withdraw.ts)
# WITHDRAW_DAILY_LIMIT_CENTS=5000000
# WITHDRAW_WEEKLY_LIMIT_CENTS=20000000
# WITHDRAW_PROTOCOL_FEE_PERCENT=0.1
# WITHDRAW_NETWORK_FEE_CENTS=100
# WITHDRAW_NETWORK_FEE_ESTIMATE_USD=0.01

# x402 cross-chain facilitator (server/src/x402/crosschain.ts) — no env vars wired yet

# Session / auth (server/src/routes/auth.ts)
# SESSION_COOKIE_TTL_MS=3600000

# CCTP cross-chain bridge (server/src/credits/cctp-client.ts)
# Per-chain RPC URL map, comma-separated `chain:url` pairs.
# Example: "ethereum:https://eth.example.com,base:https://base.example.com"
# When unset, cctp-client.ts falls back to viem's default RPC transport.
# CHAIN_RPC_URL_PER_CHAIN=

# CheapTokens reseller spend cap (server/src/inference/cheaptokens.ts)
# Per-day USDC spend cap in cents. 0 (or unset) = no cap.
# CT_DAILY_USDC_CENTS_MAX=0

# Surplus provider configuration (server/src/inference/surplus.ts + server/src/routes/admin/surplus.ts)
# All contract addresses are 0x-prefixed 20-byte EVM addresses.
# SURPLUS_MIN_DISCOUNT_PCT=0  # min acceptable discount (0-100); 0 = accept any
# SURPLUS_DEFAULT_SCHEME=upto  # "upto" or "exact"
# SURPLUS_CHAIN_ID=8453  # Base mainnet
# SURPLUS_SETTLEMENT_CONTRACT=0x0770d2124C0a581C28Cfc47a659817145e6Cc137
# SURPLUS_PERMIT2_CONTRACT=0x000000000022D473030F116dDEE9F6B43aC78BA3
# SURPLUS_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# SURPLUS_VERIFIER_CONTRACT=  # legacy EIP-712 verifyingContract; optional

# Neon Auth (server/src/auth/neon-auth.ts)
# Optional — when set, sessionAuth falls back to verifying Neon Auth JWTs
# via the JWKS URL in addition to the local HS256 token. Provisioned via
# the Neon MCP: mcp__neon__provision_neon_auth + mcp__neon__get_neon_auth_config.
# The base URL is the Neon Auth host (e.g.
#   https://ep-purple-hall-afhh6v01.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth).
# When unset, the existing SIWE / Solana / account-number auth paths are
# unaffected — Neon Auth is purely additive.
# NEON_AUTH_URL=
# NEON_AUTH_JWKS_URL=
# Allow Neon Auth tokens to satisfy sessionAuth (default: true when NEON_AUTH_URL is set)
# NEON_AUTH_ENABLED=true

# Polar.sh — usage tracking and billing integration
# Already wired in server/src/routes/polar.ts (subscription checkout) +
# server/src/inference/polar-usage.ts (meter events).
# All three product IDs come from Polar → Products after you create them.
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_WEBHOOK_SECRET=polar_whsec_...
POLAR_ORGANIZATION_ID=org_...
POLAR_SERVER=https://api.polar.sh
POLAR_HOBBY_PRODUCT_ID=
POLAR_BUILDER_PRODUCT_ID=
POLAR_SCALE_PRODUCT_ID=
# Optional — when set, every successful chat completion posts an event to
# Polar Meters so the customer is billed for what they actually used.
# Leave unset (or metr_...) to disable usage tracking. Dormant by default.
# IMPORTANT: Polar TOS forbids reselling COMPUTE. Treat this as
# subscription-bundled credits (customers buy a plan, spend credits
# within the plan), NOT pure-usage metering.
POLAR_USAGE_METER_ID=metr_...
