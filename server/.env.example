# =============================================================================
# OMA AI Gateway - Server Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp server/.env.example server/.env
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/oma

# --- Redis (optional - rate limiting/caching) ---
REDIS_URL=redis://localhost:6379

# --- AI Provider ---
VENICE_API_KEY=sk-your-venice-api-key

# --- Security ---
JWT_SECRET=your-super-secret-key-minimum-40-characters-here
# Dedicated HMAC secret for x402 settlement receipts (separate from JWT_SECRET)
# RECEIPT_HMAC_SECRET=another-random-secret-at-least-32-chars
# Webhook HMAC secret for fiat onramp callbacks (must be set in production)
# ONRAMP_WEBHOOK_SECRET=another-random-secret-at-least-32-chars

# --- Server Config ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- x402 Payment Facilitator ---
# mock = Testing (no real payments), live = Production
FACILITATOR_MODE=mock

# --- Blockchain (optional) ----
CHAIN_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- HoudiniSwap (optional - cross-chain deposits) ---
# HOUDINI_API_KEY=
# HOUDINI_API_SECRET=
# HOUDINI_PARTNER_ID=
# HOUDINI_WEBHOOK_SECRET=
# HOUDINI_ADDRESS_TO=0xYourTreasuryWallet

# --- Smart Contract Addresses (optional) ---
# OMA_TOKEN_ADDRESS=0x...
# XOMA_TOKEN_ADDRESS=0x...
# TREASURY_BASE_ADDRESS=0x...
# CHEAPTOKENS_ADDRESS=0x...
