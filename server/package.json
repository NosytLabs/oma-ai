{
  "name": "oma-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch-path=src --import tsx/esm src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "node --env-file=.env --import tsx/esm src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "@hono/node-server": "1.19.17",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@otplib/preset-default": "^12.0.1",
    "@polar-sh/sdk": "^0.49.0",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.32",
    "jose": "^6.2.3",
    "nanoid": "^5.1.15",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "siwe": "^3.0.0",
    "undici": "^8.7.0",
    "viem": "^2.53.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "uuid": ">=11.1.1",
    "elliptic": ">=6.6.1",
    "ws": ">=8.21.0",
    "@opentelemetry/core": ">=2.8.0",
    "protobufjs": ">=7.6.5",
    "brace-expansion": ">=5.0.7",
    "js-yaml": ">=4.3.0"
  }
}
