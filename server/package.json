{
  "name": "oma-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check:admin-binding": "node --env-file=.env scripts/check-admin-binding.mjs",
    "db:cleanup-local": "node --env-file=.env scripts/cleanup-local-data.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-prod": "node scripts/migrate-prod.mjs",
    "db:migrate-prod:check": "node scripts/migrate-prod.mjs --check",
    "db:push": "drizzle-kit push",
    "db:seed-test-auth": "node --env-file=.env scripts/seed-test-auth.mjs",
    "dev": "node --env-file=.env --watch-path=src --import tsx/esm src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "start": "node dist/index.js",
    "start:dev": "node --env-file=.env --import tsx/esm src/index.ts",
    "test": "vitest run",
    "test:auth:integration": "node --test --test-timeout=10000 scripts/auth-test-process.test.mjs && node scripts/test-auth-integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neon/config": "^1.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@polar-sh/sdk": "^1.0.2",
    "@upstash/redis": "^1.39.0",
    "better-auth": "1.7.12",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
