# =============================================================================
# OMA-AI production env template — COPY to .env.prod and fill real values.
# .env.prod is gitignored. NEVER commit real secrets.
# Values below are PLACEHOLDERS — replace every one.
# =============================================================================

# --- core infra (local compose services) ---
POSTGRES_PASSWORD=change-me-strong-db-pass

# --- auth / crypto secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=
RECEIPT_HMAC_SECRET=
ONRAMP_WEBHOOK_SECRET=

# --- AI provider keys (real, from Bitwarden) ---
VENICE_API_KEY=
ZERO_G_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MORPHEUS_API_KEY=
LITELLM_API_KEY=
LITELLM_PROXY_URL=
ANTSEED_PROXY_URL=
TINYFISH_API_KEY=
OMMA_ALLOW_NON_PRIVATE_VENICE=false

# --- payments / treasury (LIVE for real USDC) ---
FACILITATOR_MODE=live
FACILITATOR_PRIVATE_KEY=
SURPLUS_WALLET_PRIVATE_KEY=
TREASURY_BASE_ADDRESS=0x0770d2124C0a581C28Cfc47a659817145e6Cc137
TREASURY_SOLANA_ADDRESS=
ADMIN_WALLET_ADDRESSES=

# --- chain / RPC (QuickNode / public fallback) ---
CHAIN_RPC_URL=
CHAIN_RPC_URL_FALLBACK=
SOLANA_RPC_URL=
SOLANA_RPC_URL_FALLBACK=
BASE_CHAIN_ID=8453
