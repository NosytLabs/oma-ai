# =============================================================================
# .env.prod — OMA-AI production environment (oldpc)
# Copy from .env, then change:
#   NODE_ENV=production
#   FACILITATOR_MODE=live        (real USDC — needs funded treasury)
#   DATABASE_URL=postgresql://oma:***@postgres:5432/oma   (local, free)
#                OR Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/oma?sslmode=require
#   CLOUDFLARE_TUNNEL_TOKEN=...  (from `cloudflared tunnel create oma-ai`)
#
# NEVER commit this file. It is gitignored.
# Secrets are injected via Bitwarden (hermes config set) — keep local only.
# =============================================================================

NODE_ENV=production

# --- infra (local Postgres/Redis in compose; override DATABASE_URL for Neon) ---
DATABASE_URL=postgresql://oma:CHANGE_ME@postgres:5432/oma
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=CHANGE_ME_STRONG
PUBLIC_API_URL=https://api.oma-ai.com

# --- auth / crypto ---
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_32_plus_chars
CSRF_SECRET=CHANGE_ME_32_plus_chars
RECEIPT_HMAC_SECRET=CHANGE_ME
ONRAMP_WEBHOOK_SECRET=CHANGE_ME

# --- AI providers (inject real keys) ---
VENICE_API_KEY=
ZERO_G_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MORPHEUS_API_KEY=
LITELLM_API_KEY=
LITELLM_PROXY_URL=
ANTSEED_PROXY_URL=
TINYFISH_API_KEY=
OMMA_ALLOW_NON_PRIVATE_VENICE=false

# --- payments / treasury (LIVE) ---
FACILITATOR_MODE=live
FACILITATOR_PRIVATE_KEY=
SURPLUS_WALLET_PRIVATE_KEY=
TREASURY_BASE_ADDRESS=0x0770d2124C0a581C28Cfc47a659817145e6Cc137
TREASURY_SOLANA_ADDRESS=
ADMIN_WALLET_ADDRESSES=

# --- chain / rpc (QuickNode etc.) ---
CHAIN_RPC_URL=
CHAIN_RPC_URL_FALLBACK=
SOLANA_RPC_URL=
SOLANA_RPC_URL_FALLBACK=
BASE_CHAIN_ID=8453

# --- cloudflare tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
