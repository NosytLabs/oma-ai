# Auto-detect text/set LF line endings for all text files
* text=auto eol=lf

# Binary file types — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.webp binary
*.avif binary
*.gif binary

# Generated / vendored — linguist overrides for GitHub stats
server/src/routes/_lib/openapi-paths.ts linguist-generated=true
